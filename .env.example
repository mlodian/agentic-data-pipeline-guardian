# Copy this file to .env and fill in your own values. .env is gitignored.

# Required for the Guardian agent's Claude-powered reasoning step.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Path to the local DuckDB file standing in for the warehouse.
GUARDIAN_DB_PATH=./data/guardian.duckdb

# Optional: set to "true" to let the agent open a GitHub issue
# (via the gh CLI) for CRITICAL findings.
GUARDIAN_OPEN_GH_ISSUES=false

# Model used for the agent's reasoning step. claude-haiku-4-5-20251001 is a
# cheaper/faster option if you're running this on a frequent schedule.
GUARDIAN_MODEL=claude-sonnet-4-5-20250929
